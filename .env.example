# Đường dẫn gốc của web
VITE_APP_PUBLIC_PATH=/
# Trang mở đầu sau khi đăng nhập
VITE_APP_DEFAULT_ROUTE=/dashboard
# Base URL của API. Dev dùng proxy của Vite (VITE_DEV_API_TARGET) nên để /cmc/api.
VITE_APP_API_BASE_URL=/cmc/api
# Backend CMC khi chạy `npm run dev` (proxy /cmc/api -> đây)
VITE_DEV_API_TARGET=http://localhost:8010
# Nền bản đồ CMC tự host (repo backend: docker-compose.map.yml). Bỏ trống → cùng máy với web, cổng 8090.
# {r} = "@2x" trên màn hình nét (Leaflet tự thay), ô ảnh 512 px rõ chữ hơn.
# ?v= : tăng mỗi khi backend đổi kiểu bản đồ / dữ liệu nền để trình duyệt bỏ ảnh cũ đã lưu tạm.
VITE_MAP_TILE_URL=http://localhost:8090/styles/cmc/{z}/{x}/{y}{r}.png?v=3
