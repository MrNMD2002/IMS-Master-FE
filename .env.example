# Đường dẫn gốc của web
VITE_APP_PUBLIC_PATH=/
# Trang mở đầu sau khi đăng nhập
VITE_APP_DEFAULT_ROUTE=/dashboard
# Base URL của API. Dev dùng proxy của Vite (VITE_DEV_API_TARGET) nên để /ims/api.
VITE_APP_API_BASE_URL=/ims/api
# Backend IMS khi chạy `npm run dev` (proxy /ims/api -> đây)
VITE_DEV_API_TARGET=http://localhost:8010
